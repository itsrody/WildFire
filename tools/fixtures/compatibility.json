{
  "version": 1,
  "cases": [
    {
      "name": "uBO basic network and exception",
      "sourceKind": "ubo",
      "rules": [
        "||ads.example^$script,third-party",
        "@@||ads.example/allow.js$script"
      ],
      "expect": {
        "capabilities": [
          "NETWORK",
          "EXCEPTION",
          "THIRD_PARTY"
        ],
        "diagnostics": []
      },
      "matches": [
        {
          "url": "https://ads.example/app.js",
          "type": "script",
          "documentUrl": "https://site.test/",
          "blocked": true
        },
        {
          "url": "https://ads.example/allow.js",
          "type": "script",
          "documentUrl": "https://site.test/",
          "blocked": false
        }
      ]
    },
    {
      "name": "uBO important overrides exception",
      "sourceKind": "ubo",
      "rules": [
        "@@||ads.example^$script",
        "||ads.example^$script,important"
      ],
      "matches": [
        {
          "url": "https://ads.example/app.js",
          "type": "script",
          "documentUrl": "https://site.test/",
          "blocked": true,
          "important": true
        }
      ]
    },
    {
      "name": "AdGuard scriptlet and exception",
      "sourceKind": "adguard",
      "scriptlets": true,
      "rules": [
        "example.com#%#//scriptlet('set-constant', 'foo', '1')",
        "example.com#@%#//scriptlet('set-constant', 'foo', '1')"
      ],
      "expect": {
        "capabilities": [
          "SCRIPTLET"
        ],
        "scriptletCount": 2
      }
    },
    {
      "name": "ABP-style cosmetic and unsupported-safe",
      "sourceKind": "abp",
      "rules": [
        "example.com##.ad-banner",
        "example.com#?#div:-abp-has(.ad)",
        "example.com#?#div:-abp-contains(Ad)",
        "example.com#@?#div:-abp-has(.ad)"
      ],
      "expect": {
        "capabilities": [
          "COSMETIC",
          "PROCEDURAL"
        ]
      },
      "cosmetic": [
        {
          "host": "example.com",
          "includes": [
            ".ad-banner"
          ],
          "excludes": []
        }
      ],
      "proceduralCount": {
        "host": "example.com",
        "count": 1
      }
    },
    {
      "name": "badfilter compile-time negation",
      "rules": [
        "||ads.example^$script",
        "||ads.example^$script,badfilter",
        "||keep.example^$script"
      ],
      "expect": {
        "capabilities": [
          "NETWORK",
          "BADFILTER"
        ],
        "diagnosticCategories": [
          "network"
        ]
      },
      "matches": [
        {
          "url": "https://ads.example/a.js",
          "type": "script",
          "documentUrl": "https://site.test/",
          "blocked": false
        },
        {
          "url": "https://keep.example/a.js",
          "type": "script",
          "documentUrl": "https://site.test/",
          "blocked": true
        }
      ]
    },
    {
      "name": "alias normalization 1p/3p/xhr/css/frame/doc/all",
      "rules": [
        "||a.example^$1p,script",
        "||b.example^$3p,script",
        "||c.example^$xhr",
        "||d.example^$css",
        "||e.example^$frame",
        "||f.example^$doc"
      ],
      "expect": {
        "capabilities": [
          "NETWORK",
          "THIRD_PARTY",
          "DOCUMENT"
        ]
      },
      "matches": [
        {
          "url": "https://a.example/x.js",
          "type": "script",
          "documentUrl": "https://a.example/",
          "blocked": true
        },
        {
          "url": "https://a.example/x.js",
          "type": "script",
          "documentUrl": "https://other.test/",
          "blocked": false
        },
        {
          "url": "https://b.example/x.js",
          "type": "script",
          "documentUrl": "https://other.test/",
          "blocked": true
        },
        {
          "url": "https://c.example/x",
          "type": "xmlhttprequest",
          "documentUrl": "https://site.test/",
          "blocked": true
        },
        {
          "url": "https://d.example/x",
          "type": "stylesheet",
          "documentUrl": "https://site.test/",
          "blocked": true
        },
        {
          "url": "https://e.example/x",
          "type": "subdocument",
          "documentUrl": "https://site.test/",
          "blocked": true
        },
        {
          "url": "https://f.example/x",
          "type": "document",
          "documentUrl": "https://site.test/",
          "blocked": true
        }
      ]
    },
    {
      "name": "invalid regex and unknown alias rejected safely",
      "rules": [
        "||ok.example^",
        "/(a+)+$/",
        "||bad.example^$csp=unknown-alias",
        "||bad.example^$rewrite=unknown-alias"
      ],
      "expect": {
        "diagnosticCategories": [
          "network",
          "csp",
          "rewrite"
        ]
      },
      "matches": [
        {
          "url": "https://ok.example/x.js",
          "type": "script",
          "documentUrl": "https://site.test/",
          "blocked": true
        }
      ]
    },
    {
      "name": "removeparam/removeheader parsed capability-gated",
      "rules": [
        "||track.example^$removeparam=utm_source",
        "||api.example^$removeheader=request:cookie",
        "@@||track.example^$removeparam=utm_source"
      ],
      "expect": {
        "capabilities": [
          "NETWORK",
          "REMOVEPARAM",
          "REMOVEHEADER",
          "EXCEPTION"
        ]
      },
      "matches": [
        {
          "url": "https://track.example/pixel?utm_source=x",
          "type": "image",
          "documentUrl": "https://site.test/",
          "blocked": false
        }
      ]
    },
    {
      "name": "hide exception modifiers with badfilter",
      "rules": [
        "##.global",
        "example.com##.specific",
        "@@||example.com^$specifichide",
        "@@||example.com^$specifichide,badfilter"
      ],
      "cosmetic": [
        {
          "host": "example.com",
          "includes": [
            ".global",
            ".specific"
          ]
        }
      ],
      "expect": {
        "capabilities": [
          "COSMETIC",
          "BADFILTER"
        ]
      }
    },
    {
      "name": "ABP unsupported action selectors rejected",
      "rules": [
        "example.com#?#div:-abp-has(.ad)",
        "example.com#?#div:-abp-remove()",
        "example.com#?#div:-abp-properties(color: red)"
      ],
      "expect": {
        "capabilities": [
          "COSMETIC",
          "PROCEDURAL"
        ]
      },
      "proceduralCount": {
        "host": "example.com",
        "count": 1
      }
    },
    {
      "name": "matches-css computed-style procedural",
      "rules": [
        "example.com##div:matches-css(position: fixed)",
        "example.com##div:matches-css-before(content: \"ad\")",
        "example.com##div:matches-css(bad argument)"
      ],
      "expect": {
        "capabilities": [
          "COSMETIC",
          "PROCEDURAL"
        ],
        "diagnosticCategories": [
          "cosmetic"
        ]
      },
      "proceduralCount": {
        "host": "example.com",
        "count": 2
      }
    }
  ]
}
